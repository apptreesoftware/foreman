<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tonetonic.foreman</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__REPO__/tools/foreman/launchd/foreman.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HOME__/.tone_tonic/logs/foreman.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.tone_tonic/logs/foreman.err.log</string>
  <key>WorkingDirectory</key><string>__REPO__</string>
</dict>
</plist>
