#!/bin/zsh
# `foreman` — one command for the daemon, so nobody has to remember the pnpm incantation.
# Install once:  tools/foreman/bin/foreman install   (symlinks itself into ~/.local/bin)
set -euo pipefail

# `:A` resolves the symlink, so an installed copy still finds the clone it points into.
SELF="${0:A}"
WRAPPER_REPO="${SELF:h:h:h:h}"
STATE_DIR="$HOME/.tone_tonic"
CONFIG="$STATE_DIR/foreman.json"
LOG="$STATE_DIR/foreman.log"

# The daemon must run from the clone it is configured to build in, not from whichever
# worktree this script happens to live in.
config_value() {
  local key="$1" fallback="$2"
  [[ -r "$CONFIG" ]] || { print -r -- "$fallback"; return }
  python3 - "$CONFIG" "$key" "$fallback" <<'PY' 2>/dev/null || print -r -- "$fallback"
import json, os, sys
cfg, key, fallback = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    v = json.load(open(cfg)).get(key, fallback)
except Exception:
    v = fallback
print(os.path.expanduser(str(v)))
PY
}

REPO="$(config_value repoDir "$WRAPPER_REPO")"
PORT="$(config_value webPort 8090)"

usage() {
  cat <<EOF
foreman — Tone & Tonic daemon control

  foreman status [--watch] [--json]   what it is doing, what it waits on
  foreman next                        what the next tick would do, and why
  foreman start                       start the daemon detached (log: $LOG)
  foreman stop                        stop it, keep the claim (resumable)
  foreman abort                       stop it and release the running session
  foreman go                          clear STOP and wake it
  foreman model [<name>]              show, or set, the model sessions run as
  foreman restart                     stop, then start
  foreman update                      pull the clone and install deps
  foreman logs [-f]                   tail the daemon log
  foreman page                        open the web page
  foreman install                     symlink this script into ~/.local/bin

clone: $REPO
EOF
}

# The daemon's own record, not a process-name guess: the real command line is
# `.../tsx/dist/cli.mjs src/main.ts`, so pgrep for "tsx src/main.ts" matched nothing and
# `start` happily ran a second daemon against the same state.json (#199).
daemon_pid() {
  local pid
  # A heredoc cannot be read back through $( ), so this stays a one-liner.
  pid="$(python3 -c 'import json,sys
try: s = json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
if s.get("exitedAt") is None and isinstance(s.get("pid"), int): print(s["pid"])' \
    "$STATE_DIR/state.json" 2>/dev/null)"
  # Must end successfully even when there is no daemon: under `set -e`, a function that returns
  # non-zero inside `x="$(daemon_pid)"` kills the whole script — which is exactly how `start`
  # and `restart` came to do nothing at all, silently (#201).
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then print -r -- "$pid"; fi
  return 0
}

# Warns when something else holds the web port — the symptom of a stale daemon still running:
# the old process serves a frozen page while the new one does the work.
port_owner() {
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1
  return 0
}

ctl() {
  (cd "$REPO" && pnpm --silent --filter @tone/foreman ctl "$@")
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
  status|next|stop|abort|go|model)
    ctl "$cmd" "$@"
    if [[ "$cmd" == "status" ]]; then
      owner="$(port_owner)"
      pid="$(daemon_pid)"
      if [[ -n "$owner" && -n "$pid" && "$owner" != "$pid" ]]; then
        print -u2 "warning: port $PORT is held by pid $owner, not the daemon (pid $pid)."
        print -u2 "         the page is being served by a stale process; kill $owner and restart."
      fi
    fi
    ;;
  start)
    running="$(daemon_pid)"
    if [[ -n "$running" ]]; then
      print -u2 "foreman: already running (pid $running); use 'foreman restart'"
      exit 1
    fi
    mkdir -p "$STATE_DIR"
    (cd "$REPO" && nohup pnpm --filter @tone/foreman start >>"$LOG" 2>&1 &)
    print "foreman: started; log $LOG"
    ;;
  restart)
    running="$(daemon_pid)"
    if [[ -n "$running" ]]; then
      ctl stop
      # ctl stop returns once the daemon has posted its ledger comment and exited, but give the
      # port a moment to come free so the new daemon can bind the page.
      for _ in {1..20}; do
        [[ -z "$(daemon_pid)" ]] && break
        sleep 0.5
      done
    fi
    "$SELF" start
    ;;
  update)
    git -C "$REPO" pull --ff-only
    (cd "$REPO" && pnpm install)
    ;;
  logs)
    if [[ "${1:-}" == "-f" ]]; then tail -f "$LOG"; else tail -n 50 "$LOG"; fi
    ;;
  page)
    open "http://127.0.0.1:$PORT"
    ;;
  install)
    mkdir -p "$HOME/.local/bin"
    ln -sf "$SELF" "$HOME/.local/bin/foreman"
    print "installed: $HOME/.local/bin/foreman -> $SELF"
    case ":$PATH:" in
      *":$HOME/.local/bin:"*) ;;
      *) print -u2 "warning: ~/.local/bin is not on PATH; add it in ~/.zshrc" ;;
    esac
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    print -u2 "foreman: unknown command '$cmd'"
    usage
    exit 2
    ;;
esac
